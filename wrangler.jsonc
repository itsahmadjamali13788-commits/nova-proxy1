{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nova-proxy1",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "2b2d0831-3c1b-4fd5-99ed-8df9f7cda8ab","database_name": "nova-proxy1" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "e2f4cea27fa440aab8d6db10476e1421" }
  ],
  "vars": {
    "PAGES_URL": "https://nova-panel.github.io"
  },
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
